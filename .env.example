# mock: offline rule-based model for demo / CI (no key required)
# openai: any OpenAI-compatible Chat Completions endpoint with tool calling
NL2SQL_PROVIDER=mock

# Only required when NL2SQL_PROVIDER=openai
NL2SQL_API_KEY=
NL2SQL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NL2SQL_MODEL=qwen-plus

# Runtime limits
NL2SQL_MAX_STEPS=12
NL2SQL_MAX_ROWS=200
NL2SQL_QUERY_TIMEOUT_MS=5000
NL2SQL_MAX_TOKENS=4096
# Set to false if your endpoint rejects the non-standard enable_thinking field
NL2SQL_DISABLE_THINKING=true
NL2SQL_ALLOW_SENSITIVE=false
NL2SQL_REQUEST_TIMEOUT_SEC=120
NL2SQL_DEMO_TODAY=2026-07-01

# Optional: base directory for var/ (demo db + experience db)
# NL2SQL_HOME=.
