# mock: offline rule-based model for demo / CI (no key required)
# openai: any OpenAI-compatible Chat Completions endpoint with tool calling
NL2SQL_PROVIDER=mock

# Only required when NL2SQL_PROVIDER=openai
NL2SQL_API_KEY=
NL2SQL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NL2SQL_MODEL=qwen-plus

# Route. auto = deterministic pipeline (retrieve -> one tool-free generation -> guard
# -> execute -> phrase) on a an online provider with a an attached catalog, tool loop otherwise;
# pipeline = always the deterministic path; agent = always the tool-calling loop.
# A pipeline turn costs 2-4 model calls instead of up to NL2SQL_MAX_STEPS; when it
# cannot reach an executed answer it escalates to the tool loop, so it never loses a
# turn that the loop could still answer.
NL2SQL_MODE=auto

# Runtime limits
NL2SQL_MAX_STEPS=12
NL2SQL_MAX_ROWS=200
NL2SQL_QUERY_TIMEOUT_MS=5000
NL2SQL_MAX_TOKENS=4096
# Set to false if your endpoint rejects the non-standard enable_thinking field
NL2SQL_DISABLE_THINKING=true
NL2SQL_ALLOW_SENSITIVE=false
NL2SQL_REQUEST_TIMEOUT_SEC=120
NL2SQL_DEMO_TODAY=2026-07-01

# Resilience. Only the real (openai-compatible) provider is wrapped; mock never
# touches the network, so these knobs do not change offline measurements.
# Transient = timeout / connection error / 429 / 5xx. 400-class errors are never retried.
NL2SQL_LLM_RETRIES=1
# Backoff starts here and doubles per retry, capped at 30s.
NL2SQL_LLM_RETRY_BACKOFF_SEC=2.0
# Consecutive failed attempts before the circuit opens; 0 disables the breaker.
NL2SQL_LLM_CIRCUIT_FAILURES=5
# Seconds an open circuit waits before allowing a single half-open probe.
NL2SQL_LLM_CIRCUIT_RESET_SEC=30.0
# SQL is retried only for pool_unavailable; sql_error and timeout are never repeated.
NL2SQL_SQL_RETRIES=1
NL2SQL_SQL_RETRY_BACKOFF_SEC=0.05
# The experience store always opens in WAL mode with a 10s busy_timeout (no knob).

# AI Judge (optional, disabled by default; deterministic gold comparison always runs)
NL2SQL_JUDGE_ENABLED=false
NL2SQL_JUDGE_PROVIDER=openai
NL2SQL_JUDGE_MODEL=qwen-max
# Falls back to NL2SQL_BASE_URL / NL2SQL_API_KEY when empty
NL2SQL_JUDGE_BASE_URL=
NL2SQL_JUDGE_API_KEY=
NL2SQL_JUDGE_MAX_TOKENS=800
NL2SQL_JUDGE_MAX_ROWS=20
NL2SQL_JUDGE_CACHE_PATH=var/judge_cache.sqlite
NL2SQL_JUDGE_PROMPT_VERSION=judge-v2
NL2SQL_JUDGE_MAX_CALLS=100

# Experience loop (verified-only few-shot injection + failure queue)
# Inject human-verified experiences into the system prompt automatically
NL2SQL_FEWSHOT_ENABLED=true
NL2SQL_FEWSHOT_MAX=3
NL2SQL_FEWSHOT_MAX_CHARS=1200
# Queue terminal failures (needs_human / failed / max_steps) for human triage
NL2SQL_CAPTURE_FAILURES=true
# Hard cap on repair_sql rounds per question
NL2SQL_MAX_REPAIRS=2
# Score bonus for verified experiences in the same category (0 disables)
NL2SQL_CATEGORY_BOOST=0.12
# MMR diversity weight for few-shot selection (0 = legacy top-k, bit-for-bit)
NL2SQL_FEWSHOT_DIVERSITY=0.0
# Experience recall channel: lexical | vector | rrf (rrf falls back to lexical
# unless a vector provider is configured)
NL2SQL_EXPERIENCE_RECALL=rrf
# Enable the vector channel for experience recall (requires an embedding provider)
NL2SQL_EXPERIENCE_VECTOR=false
# Ranking bonus for quality=gold rows, scaled by the arm's top base score
NL2SQL_EXPERIENCE_GOLD_BOOST=0.05

# Multi-turn follow-up rewriting (anaphora + ellipsis resolution)
NL2SQL_MULTI_TURN=true
# Rewriting channel: auto (model when a key exists, else rules) | rule | llm | off
NL2SQL_REWRITER=auto
# Turns of conversation history handed to the rewriting model
NL2SQL_HISTORY_TURNS=3
# Hand a follow-up the SQL that already executed last turn, so a narrowing
# question edits that SQL instead of re-searching a 500-table catalog from zero.
NL2SQL_CARRY_PRIOR_SQL=true
# Consecutive exploratory calls (search_tables / get_table_schema / search_values /
# search_experience) allowed before one nudge tells the model to write and execute
# SQL instead of keeps probing (0 disables the nudge)
NL2SQL_MAX_VALUE_PROBES=4

# Dual-channel execution voting (opt-in; one extra model call + one extra query)
# Second channel is asked when the primary confidence is below this ...
NL2SQL_DUAL_CHANNEL=false
NL2SQL_DUAL_CHANNEL_CONFIDENCE=0.75
# ... or when the question is in one of these categories (JOIN fan-out / recursion risk).
# Set to an empty value to rely on confidence only.
NL2SQL_DUAL_CHANNEL_CATEGORIES=bom,kitting
# Confidence added when both channels return the same result set
NL2SQL_DUAL_CHANNEL_BOOST=0.1

# Result cache for repeated questions (off by default: every published number is
# measured on the uncached path, and eval always bypasses the cache).
# Key = normalized question + schema hash + principal + permission + prompt/recall
# policy + conversation prefix; only ok turns with an executed SQL are stored.
# NL2SQL_RESULT_CACHE_TTL_SEC=60
NL2SQL_RESULT_CACHE_TTL_SEC=0
NL2SQL_RESULT_CACHE_MAX=128

# Cost dashboard is user-priced: no vendor price is hardcoded. Setting only one of
# input/output raises instead of producing a half-cost estimate. Cached prompt tokens
# are discounted when a cached-input price is set; unclassified tokens are priced at
# the input rate as an explicit lower bound.
# NL2SQL_PRICE_INPUT_PER_1M=2.0
# NL2SQL_PRICE_OUTPUT_PER_1M=8.0
# NL2SQL_PRICE_CACHED_INPUT_PER_1M=0.5
# NL2SQL_PRICE_CURRENCY=USD

# Prompt gray release (off by default). Traffic is split by a deterministic bucket
# sha256(salt:key) mod 10000, so one conversation stays on one arm across turns and
# processes. The candidate layout only moves the few-shot block before the JSON
# contract; eval is forced to one arm with --prompt-version.
# NL2SQL_GRAY_PERCENT=10
# NL2SQL_GRAY_PROMPT_VERSION=agent-v5-fewshot-early
# NL2SQL_GRAY_SALT=gray-v1

# Optional: query a real SQL Server instead of the bundled SQLite demo.
# Everything here is local-only: never commit real hosts, accounts or passwords.
# Schema linking follows that database once you run: nl2sql-agent schema-sync
# NL2SQL_DB_BACKEND=mssql
# NL2SQL_MSSQL_SERVER=127.0.0.1
# NL2SQL_MSSQL_PORT=1433
# NL2SQL_MSSQL_DATABASE=your_database
# NL2SQL_MSSQL_USERNAME=read_only_account
# NL2SQL_MSSQL_PASSWORD=
# NL2SQL_MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# NL2SQL_MSSQL_TRUST_CERTIFICATE=true

# Optional: query a real PostgreSQL instead (pip install -e ".[postgres]").
# Same read-only rule as SQL Server: use an account that can only SELECT, and let
# the session statements (default_transaction_read_only + statement_timeout) bound
# each query. Local-only, never commit real hosts or passwords.
# NL2SQL_DB_BACKEND=postgres
# NL2SQL_PG_HOST=127.0.0.1
# NL2SQL_PG_PORT=5432
# NL2SQL_PG_DATABASE=your_database
# NL2SQL_PG_USERNAME=read_only_account
# NL2SQL_PG_PASSWORD=
# NL2SQL_PG_SSLMODE=prefer
# Reuse physical connections across queries (default 1 = open one per query, which
# is the behaviour every published number was measured against).
# NL2SQL_DB_POOL_SIZE=1
# Catalog generated by schema-sync (default when unset: bundled synthetic demo)
# NL2SQL_SCHEMA_PATH=var/schema_your_database.json
# Human-reviewed semantic overlay merged over the raw catalog (default: <home>/var/schema_overlay.json)
# NL2SQL_SCHEMA_OVERLAY=var/schema_overlay.json
# Draft mappings produced by schema-suggest (default: <home>/var/schema_suggestions.json)
# NL2SQL_SCHEMA_SUGGESTIONS=var/schema_suggestions.json
# Local case set for eval / link-check (default when unset: bundled synthetic cases)
# NL2SQL_EVAL_CASES=var/erp_cases.jsonl
# Schema linking strategy: auto (scale-aware, default), or one of
# baseline table_only column_downweight no_length_norm comment_synonyms
# coverage thin_columns_no_norm mined_no_columns_no_norm hybrid
# vector / rrf additionally need NL2SQL_EMBEDDING below.
# NL2SQL_LINKING=auto

# Hybrid schema linking (off by default: BM25 stays the measured baseline)
# none: lexical only | hash: deterministic offline stand-in | openai: real embeddings
NL2SQL_EMBEDDING=none
# Any OpenAI-compatible /embeddings model; DashScope uses text-embedding-v4
NL2SQL_EMBEDDING_MODEL=text-embedding-v4
# Falls back to NL2SQL_BASE_URL / NL2SQL_API_KEY when empty
NL2SQL_EMBEDDING_BASE_URL=
NL2SQL_EMBEDDING_API_KEY=
# hash provider only: bucket count for the offline stand-in
NL2SQL_EMBEDDING_DIMENSIONS=256
# Texts per /embeddings request (DashScope caps batches, 10 is safe)
NL2SQL_EMBEDDING_BATCH_SIZE=10
# One file per schema_hash + provider + document fingerprint
NL2SQL_EMBEDDING_CACHE=var/embeddings
# Reciprocal rank fusion constant; larger k flattens the rank contribution
NL2SQL_LINKING_RRF_K=60

# Optional LLM rerank of the top candidates (needs NL2SQL_PROVIDER=openai)
NL2SQL_RERANK=off
NL2SQL_RERANK_CANDIDATES=12
# NL2SQL_LINKING=auto

# Value alignment: resolve what the user says (杭智, 东区, 待发货) to the value
# the database stores (sales_order.customer_name, 华东, pending) before
# generation. on | off. off is byte-identical to the pre-alignment agent: an
# unmatched question is passed through untouched, and a mention that maps to
# more than one stored value asks for clarification instead of guessing.
NL2SQL_VALUE_ALIGNMENT=on
# Business dictionary (default when unset: the bundled synthetic demo dictionary)
# NL2SQL_VALUE_DICTIONARY=src/nl2sql_agent/data/value_dictionary.json

# Clarification policy: which gaps block and which only get an offer. off | options | ask.
# options (default) still answers a question that only lacks a 口径 or a period, and hands
# back the exact sentences that would make it narrower; only an entity that maps to several
# stored values, a permission gap or a metric the catalog does not have may block. Measured
# on the frozen corpus: ask would block 4 of 123 questions that already have an answer.
NL2SQL_CLARIFY=options
# Ambiguous business nouns and the question that states each reading. When unset the
# packaged in-code table is used (3 nouns / 8 readings, all synthetic demo vocabulary);
# a deployment points at its own file. Whether 销售额 includes tax is a business
# convention, so that table must live outside the repository.
# NL2SQL_METRIC_GLOSSARY=/etc/nl2sql/metric_glossary.json

# Optional AST guard (pip install -e ".[ast]"): a second opinion on structure
# behind the regex rules — SELECT INTO, escalation functions, catalog introspection
# and table references the tokenizer cannot see. off | on. When on it fails closed:
# a statement sqlglot cannot parse is refused, so an unreachable parser is never a
# silent downgrade to regex-only approval.
NL2SQL_AST_GUARD=off

# Optional row-level / column-level access control. One principal per run:
# the agent-facing schema is filtered (unauthorized tables and columns never reach
# the prompt or the tools) while the guard keeps the full catalog, so a blocked
# reference is reported as a permission violation instead of "table does not exist".
# NL2SQL_PRINCIPAL=rep_east
# Role file (default when unset: the bundled synthetic demo roles)
# NL2SQL_PRINCIPALS=src/nl2sql_agent/data/principals.json

# Observability: one JSON line per turn / tool call / DB call, correlated by trace_id.
# Off unless a path is set — no log path means no handler and no file at all.
# Connection strings, keys and passwords are always redacted. Business text
# (question, answer, SQL) is only written when NL2SQL_LOG_INCLUDE_TEXT=true;
# otherwise a sha256 fingerprint is kept so failures can still be grouped.
# Read it back with `nl2sql-agent metrics` / `nl2sql-agent cost` or GET /api/metrics
# and GET /api/cost. It is measurement, never a CI gate: no metric in here can fail a run.
# NL2SQL_LOG_PATH=var/nl2sql.jsonl
# NL2SQL_LOG_LEVEL=info
NL2SQL_LOG_INCLUDE_TEXT=false

# Optional: base directory for var/ (demo db + experience db)
# NL2SQL_HOME=.
